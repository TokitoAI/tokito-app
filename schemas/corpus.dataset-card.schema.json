{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schemas/corpus.dataset-card.schema.json",
  "title": "Tokito Corpus Dataset Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "dataset_revision", "created_at", "purpose", "visibility", "sources", "annotation_contract", "retention", "exclusions", "change_history", "hashes"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_revision": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "purpose": { "type": "string", "minLength": 1 },
    "visibility": { "enum": ["public", "contributed", "synthetic", "private", "mixed"] },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "origin", "retrieved_at", "license", "consent", "intended_uses", "restrictions"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "minLength": 1 },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "license": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "identifier", "uri", "redistributable", "review_status"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "identifier": { "type": "string", "minLength": 1 },
              "uri": { "type": "string", "minLength": 1 },
              "redistributable": { "type": "boolean" },
              "review_status": { "enum": ["approved", "rejected", "review-required"] }
            }
          },
          "consent": {
            "type": "object", "additionalProperties": false,
            "required": ["required", "basis", "scope"],
            "properties": {
              "required": { "type": "boolean" },
              "basis": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 }
            }
          },
          "intended_uses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "restrictions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "annotation_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "identity_fields", "geometry_types", "state_fields", "uncertainty", "unobservable_regions"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "identity_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "geometry_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["bbox", "polygon", "keypoint", "transform", "none"] } },
        "state_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "uncertainty": { "type": "string", "minLength": 1 },
        "unobservable_regions": { "type": "string", "minLength": 1 }
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_media", "derived_artifacts", "removal_sla_days"],
      "properties": {
        "raw_media": { "type": "string", "minLength": 1 },
        "derived_artifacts": { "type": "string", "minLength": 1 },
        "removal_sla_days": { "type": "integer", "minimum": 0 }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule_id", "reason"],
        "properties": { "rule_id": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } }
      }
    },
    "change_history": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["change_id", "base_revision", "target_revision", "change_set_digest"],
        "properties": {
          "change_id": { "type": "string", "minLength": 1 },
          "base_revision": { "type": "string", "minLength": 1 },
          "target_revision": { "type": "string", "minLength": 1 },
          "change_set_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["inventory_manifest_digest", "annotation_manifest_digest", "split_manifest_digest", "manifest_digest"],
      "properties": {
        "inventory_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "annotation_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "split_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
