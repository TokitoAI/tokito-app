{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schemas/model.bundle-manifest.schema.json",
  "title": "Tokito Model Bundle Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_revision",
    "capability",
    "source",
    "export",
    "preprocessing",
    "labels",
    "calibration",
    "backend_requirements",
    "conformance",
    "activation"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "bundle_revision": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["training_revision", "license", "checkpoint_digest"],
      "properties": {
        "training_revision": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "checkpoint_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "export": {
      "type": "object",
      "required": ["format", "artifact_digest", "quantization", "reproducible_command"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "quantization": { "type": "string", "minLength": 1 },
        "reproducible_command": { "type": "string", "minLength": 1 }
      }
    },
    "preprocessing": { "type": "object", "required": ["digest"], "properties": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
    "labels": { "type": "array", "items": { "type": "string" } },
    "calibration": { "type": "object", "required": ["policy_id", "revision"], "properties": { "policy_id": { "type": "string" }, "revision": { "type": "string" } } },
    "backend_requirements": { "type": "array", "items": { "type": "string" } },
    "conformance": {
      "type": "object",
      "required": ["reference_vectors_digest", "thresholds", "results_digest"],
      "properties": {
        "reference_vectors_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "thresholds": { "type": "object" },
        "results_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "activation": {
      "type": "object",
      "required": ["signature", "minimum_runtime_version", "rollback_bundle_id"],
      "properties": {
        "signature": { "type": "string", "minLength": 1 },
        "minimum_runtime_version": { "type": "string", "minLength": 1 },
        "rollback_bundle_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
