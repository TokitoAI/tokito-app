{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schemas/corpus.change-set.schema.json",
  "title": "Tokito Corpus Change Set",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "change_id", "dataset_id", "base_revision", "base_dataset_digest", "target_revision", "created_at", "reason", "operations", "integrity"],
  "properties": {
    "schema_version": { "const": "1.0" }, "change_id": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1 }, "base_revision": { "type": "string", "minLength": 1 },
    "base_dataset_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "target_revision": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }, "reason": { "type": "string", "minLength": 1 },
    "operations": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["operation", "item_id", "reason"], "properties": { "operation": { "enum": ["remove", "correct"] }, "item_id": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "patch": { "type": "object" }, "invalidate_annotations": { "type": "boolean" }, "replacement_annotations": { "type": "array", "items": { "type": "object" } } } } },
    "integrity": { "type": "object", "additionalProperties": false, "required": ["manifest_digest"], "properties": { "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } }
  }
}
