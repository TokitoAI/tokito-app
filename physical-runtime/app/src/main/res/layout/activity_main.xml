<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tokito_background">

    <ai.tokito.physical.ar.ArCameraSurface
        android:id="@+id/cameraSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/camera_content_description" />

    <View
        android:layout_width="match_parent"
        android:layout_height="144dp"
        android:background="@drawable/top_camera_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/product_title"
            android:textColor="@color/tokito_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/trackingChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_pill"
            android:ellipsize="end"
            android:maxWidth="180dp"
            android:singleLine="true"
            android:text="@string/camera_starting"
            android:textColor="@color/tokito_text"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/arControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/generateSymbolsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:text="@string/generate_symbols"
            android:contentDescription="@string/generate_symbols_description"
            android:textAllCaps="false"
            android:visibility="gone"
            app:cornerRadius="8dp"
            app:strokeColor="@color/tokito_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewDigitalTwinButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:contentDescription="@string/preview_digital_twin_description"
            android:minWidth="0dp"
            android:text="@string/preview_digital_twin"
            android:textAllCaps="false"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_menu_view"
            app:iconGravity="textStart"
            app:strokeColor="@color/tokito_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/registerArButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:text="@string/register_ar"
            android:textAllCaps="false"
            app:cornerRadius="8dp"
            app:strokeColor="@color/tokito_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetRegistrationButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:text="@string/reset_ar"
            android:textAllCaps="false"
            app:cornerRadius="8dp"
            app:strokeColor="@color/tokito_border" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/voiceControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/callStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/status_pill"
            android:ellipsize="end"
            android:maxWidth="180dp"
            android:saveEnabled="false"
            android:singleLine="true"
            android:text="@string/call_ready"
            android:textColor="@color/tokito_text"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp">

            <ProgressBar
                android:id="@+id/callProgress"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:indeterminateTint="@color/tokito_primary"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/callButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@string/call_ready"
                android:saveEnabled="false"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="64dp"
                android:minHeight="64dp"
                app:backgroundTint="@color/tokito_primary"
                app:cornerRadius="32dp"
                app:icon="@android:drawable/ic_btn_speak_now"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp"
                app:iconTint="@color/tokito_on_primary" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recordMeasurementButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/record_measurement_description"
            android:text="@string/record_measurement"
            android:textAllCaps="false"
            app:cornerRadius="12dp"
            app:strokeColor="@color/tokito_border" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/measurementPanel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="132dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/status_pill"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/measurementStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/measurement_listening"
            android:textColor="@color/tokito_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/discardMeasurementButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/measurement_discard"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmMeasurementButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/measurement_confirm"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/permissionRecoveryButton"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/allow_camera_description"
        android:text="@string/allow_camera"
        android:textAllCaps="false"
        android:visibility="gone"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_camera"
        app:iconGravity="textStart" />
</FrameLayout>
