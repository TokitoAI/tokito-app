{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schemas/assembly.context-bundle.schema.json",
  "title": "Tokito Assembly Context Bundle",
  "type": "object",
  "required": ["schema_version", "board", "components", "landmarks", "sources", "integrity"],
  "properties": {
    "schema_version": {
      "type": "object",
      "required": ["major", "minor"],
      "properties": {
        "major": { "type": "integer", "minimum": 1 },
        "minor": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "board": {
      "type": "object",
      "required": ["board_id", "revision", "coordinate_frame_id", "units", "handedness", "outline"],
      "properties": {
        "board_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "coordinate_frame_id": { "type": "string", "minLength": 1 },
        "units": { "const": "mm" },
        "handedness": { "enum": ["left", "right"] },
        "outline": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point" }
        }
      },
      "additionalProperties": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reference_designator", "footprint", "centroid", "rotation_degrees", "side", "placement_source_id"],
        "properties": {
          "reference_designator": { "type": "string", "minLength": 1 },
          "footprint": { "type": "string", "minLength": 1 },
          "centroid": { "$ref": "#/$defs/point" },
          "rotation_degrees": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
          "side": { "enum": ["top", "bottom"] },
          "polarity_or_pin_one": { "type": ["string", "null"] },
          "alternates": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "placement_source_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["landmark_id", "position"],
        "properties": {
          "landmark_id": { "type": "string", "minLength": 1 },
          "position": { "$ref": "#/$defs/point" }
        },
        "additionalProperties": true
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "role", "license", "digest"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["authored_placement", "datasheet", "supporting"] },
          "license": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": true
      }
    },
    "integrity": {
      "type": "object",
      "required": ["payload_sha256", "signature_id"],
      "properties": {
        "payload_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "signature_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
