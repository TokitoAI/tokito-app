{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schemas/reference.source-package-manifest.schema.json",
  "title": "Tokito Reference Source Package Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "board",
    "retrieval_policy",
    "capture_evidence_policy",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "package_id": { "type": "string", "minLength": 1 },
    "board": {
      "type": "object",
      "required": ["vendor", "product", "revision_status"],
      "properties": {
        "vendor": { "type": "string", "minLength": 1 },
        "product": { "type": "string", "minLength": 1 },
        "revision_status": {
          "enum": [
            "exact_physical_revision_recorded",
            "pending_physical_confirmation"
          ]
        }
      }
    },
    "retrieval_policy": {
      "type": "object",
      "required": [
        "default_output_directory",
        "network_downloads_require_explicit_command",
        "commit_downloaded_artifacts",
        "account_required_downloads"
      ],
      "properties": {
        "default_output_directory": { "type": "string", "minLength": 1 },
        "network_downloads_require_explicit_command": { "const": true },
        "commit_downloaded_artifacts": { "const": false },
        "account_required_downloads": { "const": false }
      }
    },
    "capture_evidence_policy": {
      "type": "object",
      "required": [
        "physical_capture_required",
        "internet_artifacts_are_physical_captures",
        "raw_captures_committed_to_git"
      ],
      "properties": {
        "physical_capture_required": { "const": true },
        "internet_artifacts_are_physical_captures": { "const": false },
        "raw_captures_committed_to_git": { "const": false }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "role",
          "kind",
          "url",
          "access",
          "retrieved_at",
          "revision",
          "artifact_format",
          "license_status",
          "trainability",
          "fetch_allowed",
          "use_in_pipeline"
        ],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "role": {
            "enum": [
              "board_reference",
              "design_truth_candidate",
              "software_reference",
              "visual_reference"
            ]
          },
          "kind": {
            "enum": [
              "product_page",
              "getting_started",
              "quick_reference",
              "user_manual",
              "schematic",
              "design_files",
              "sdk_docs",
              "product_image"
            ]
          },
          "url": { "type": "string", "minLength": 1 },
          "artifact_code": { "type": "string", "minLength": 1 },
          "access": {
            "enum": [
              "public",
              "account_required",
              "restricted"
            ]
          },
          "retrieved_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "revision": { "type": "string", "minLength": 1 },
          "artifact_format": {
            "enum": [
              "html",
              "pdf",
              "zip",
              "image",
              "metadata"
            ]
          },
          "expected_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "license_status": {
            "enum": [
              "public_metadata_only",
              "account_terms_required",
              "copyrighted_doc_terms_required",
              "redistributable_with_training_rights",
              "pending_review"
            ]
          },
          "trainability": {
            "enum": [
              "metadata_only",
              "not_trainable",
              "training_candidate_after_license_review",
              "requires_explicit_permission"
            ]
          },
          "fetch_allowed": { "type": "boolean" },
          "use_in_pipeline": {
            "enum": [
              "source_manifest_only",
              "validation_reference_after_review",
              "visual_reference_after_review",
              "training_candidate_after_license_review"
            ]
          }
        }
      }
    }
  }
}
