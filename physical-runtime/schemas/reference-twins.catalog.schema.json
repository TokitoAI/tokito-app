{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schemas/reference-twins.catalog.schema.json",
  "title": "Signed offline source-reference model catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "manifest", "glb", "context_revision"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
          "manifest": {"$ref": "#/$defs/path"},
          "glb": {"$ref": "#/$defs/path"},
          "context_revision": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
          "tracking": {"$ref": "#/$defs/path"}
        }
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^[A-Za-z0-9_-]+/(?!.*\\.\\.)[A-Za-z0-9_.-]+$"}
  }
}
