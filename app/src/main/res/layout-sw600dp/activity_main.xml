<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tokito_background">

    <ai.tokito.physical.ar.ArCameraSurface
        android:id="@+id/cameraSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/camera_content_description" />

    <View
        android:layout_width="match_parent"
        android:layout_height="144dp"
        android:background="@drawable/top_camera_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/product_title"
            android:textColor="@color/tokito_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/trackingChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_pill"
            android:ellipsize="end"
            android:maxWidth="240dp"
            android:singleLine="true"
            android:text="@string/camera_starting"
            android:textColor="@color/tokito_text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/arControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="20dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewDigitalTwinButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/preview_digital_twin_description"
            android:text="@string/preview_digital_twin"
            android:textAllCaps="false"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_menu_view"
            app:iconGravity="textStart"
            app:strokeColor="@color/tokito_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/registerArButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="@string/register_ar"
            android:textAllCaps="false"
            app:cornerRadius="8dp"
            app:strokeColor="@color/tokito_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetRegistrationButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="@string/reset_ar"
            android:textAllCaps="false"
            app:cornerRadius="8dp"
            app:strokeColor="@color/tokito_border" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:fitsSystemWindows="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/callStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/status_pill"
            android:ellipsize="end"
            android:maxWidth="200dp"
            android:saveEnabled="false"
            android:singleLine="true"
            android:text="@string/call_ready"
            android:textColor="@color/tokito_text"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp">

            <ProgressBar
                android:id="@+id/callProgress"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:indeterminateTint="@color/tokito_primary"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/callButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@string/call_ready"
                android:saveEnabled="false"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/tokito_primary"
                android:minWidth="64dp"
                android:minHeight="64dp"
                app:cornerRadius="32dp"
                app:icon="@android:drawable/ic_btn_speak_now"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp"
                app:iconTint="@color/tokito_on_primary" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
