{
  "expo": {
    "name": "Tokito Companion",
    "slug": "tokito-companion",
    "version": "0.1.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "tokito-companion",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0D10"
    },
    "android": {
      "package": "dev.tokito.companion",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07101E"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "cloudBaseUrl": "https://api.tokito.dev"
    }
  }
}
