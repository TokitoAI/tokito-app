{
  "expo": {
    "name": "Tokito Companion",
    "slug": "tokito-companion",
    "version": "0.1.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "tokito-companion",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0D10"
    },
    "android": {
      "package": "dev.tokito.companion",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/tokito-mark.png",
        "backgroundColor": "#07101E"
      },
      "permissions": ["INTERNET"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "cloudBaseUrl": "https://api.tokito.dev"
    }
  }
}
