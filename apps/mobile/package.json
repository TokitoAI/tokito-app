{
  "name": "@tokito/companion-mobile",
  "version": "0.1.1",
  "private": true,
  "description": "Tokito Companion React Native (TypeScript) shell — UniFFI auth via tokito-companion-ffi",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --non-interactive",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ index.ts",
    "test": "node --import tsx --test src/cloud.test.ts src/auth/AuthService.test.ts src/api/cloudHttp.test.ts",
    "forbid-js": "node scripts/forbid-js.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "expo": "~52.0.46",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "phosphor-react-native": "^3.0.6",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-svg": "15.8.0",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.18",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "babel-preset-expo": "~12.0.0",
    "eslint": "^9.17.0",
    "metro": "^0.81.5",
    "metro-config": "^0.81.5",
    "metro-runtime": "^0.81.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
