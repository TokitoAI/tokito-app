{
  "name": "@tokito/app-mobile",
  "version": "0.3.0",
  "private": true,
  "description": "Tokito mobile app — project review, Cloud sync, and fully native physical bench assistance",
  "main": "index.ts",
  "scripts": {
    "postinstall": "patch-package --error-on-fail && node --test scripts/dependency-patches.test.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --non-interactive",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ index.ts",
    "audit": "node scripts/audit-gate.mjs",
    "audit:test": "node --test scripts/audit-gate.test.mjs scripts/dependency-patches.test.mjs",
    "release:validate": "node scripts/release-identity.mjs",
    "test": "node --import tsx --test src/cloud.test.ts src/auth/AuthService.test.ts src/api/cloudHttp.test.ts src/sync/physicalSync.test.ts src/chat/conversationModel.test.ts src/chat/conversationClient.test.ts scripts/release-identity.test.mjs scripts/native-bridge-contract.test.mjs scripts/physical-integration.test.mjs scripts/product-boundary.test.mjs",
    "forbid-js": "node scripts/forbid-js.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.1",
    "expo-navigation-bar": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "phosphor-react-native": "^3.0.6",
    "react": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^10.8.0",
    "patch-package": "8.0.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
